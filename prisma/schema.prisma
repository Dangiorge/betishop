// ==========================================================
// Shop Management System - Prisma Schema
// Multi-tenant (shared DB, tenantId on every row)
// DB: PostgreSQL (Supabase via Neon)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------
// Tenancy & Auth
// -----------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // used in QR public URL: /s/[slug]/stock
  currency  String   @default("ETB")
  createdAt DateTime @default(now())

  users             User[]
  categories        Category[]
  products          Product[]
  variants          Variant[]
  stores            Store[]
  storeStocks       StoreStock[]
  suppliers         Supplier[]
  grns              GRN[]
  internalTransfers InternalTransfer[]
  disposals         Disposal[]
  purchaseRequests  PurchaseRequest[]
  stockMovements    StockMovement[]
  sales             Sale[]
  expenses          Expense[]
  closingPeriods    ClosingPeriod[]
  stockCounts       StockCount[]
  bankAccounts      BankAccount[]
  saleBatches       SaleBatch[]
  feedback          StoreFeedback[]
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  EMPLOYEE
  SALES_PERSON
}

model User {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  email          String   @unique
  hashedPassword String?
  role           Role     @default(EMPLOYEE)
  createdAt      DateTime @default(now())
  assignedStoreId String?
  assignedStore   Store?   @relation("AssignedStore", fields: [assignedStoreId], references: [id], onDelete: SetNull)

  // Employee-specific fields (null for admins)
  baseSalary     Decimal? @db.Decimal(12, 2)
  commissionRate Decimal? @db.Decimal(5, 2) // percentage, e.g. 5.00 = 5%

  stockMovements           StockMovement[]
  sales                    Sale[]
  stockCounts              StockCount[]
  grnsReceived             GRN[]              @relation("GRNReceivedBy")
  transfersRequested       InternalTransfer[] @relation("TransferRequestedBy")
  disposalsCreated         Disposal[]         @relation("DisposalCreatedBy")
  purchaseRequestsMade     PurchaseRequest[]  @relation("PurchaseRequestedBy")
  purchaseRequestsApproved PurchaseRequest[]  @relation("PurchaseApprovedBy")
  saleBatches              SaleBatch[]

  @@index([tenantId])
}

enum SignupStatus {
  PENDING
  APPROVED
  REJECTED
}

model SignupRequest {
  id             String       @id @default(cuid())
  businessName   String
  ownerName      String
  email          String       @unique
  hashedPassword String
  status         SignupStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  reviewedAt     DateTime?
}

// -----------------------------
// Catalog
// -----------------------------

enum ProductType {
  SHOE
  BAG
  OTHER
}

enum ProductGender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

model Category {
  id       String     @id @default(cuid())
  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  name     String
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  @@index([tenantId])
  @@index([parentId])
  @@unique([tenantId, parentId, name])
}

model Product {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  type            ProductType
  name            String
  description     String?
  brand           String?
  gender          ProductGender?
  material        String?
  countryOfOrigin String?
  tags            String[]       @default([])
  imageUrl        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  variants Variant[]

  @@index([tenantId])
  @@index([categoryId])
}

// A specific sellable version of a product (e.g. Gray / Size 42)
// Stock is no longer a single number here — see StoreStock for
// the per-store balance, now that stock is tracked per location.
model Variant {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  sku       String?  // optional internal code
  color     String?
  size      String?
  costPrice Decimal  @db.Decimal(12, 2)
  sellPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  storeStocks    StoreStock[]
  stockMovements StockMovement[]
  sales          Sale[]
  stockCounts    StockCount[]
  grnItems       GRNItem[]
  transferItems  InternalTransferItem[]
  disposalItems  DisposalItem[]
  purchaseItems  PurchaseRequestItem[]

  @@index([tenantId])
  @@index([productId])
  @@unique([tenantId, sku])
}

// -----------------------------
// Stores & per-store stock
// -----------------------------

model Store {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  name                  String
  address               String?
  allowGRN              Boolean  @default(true)
  allowInternalTransfer Boolean  @default(true)
  allowDisposal         Boolean  @default(true)
  allowPurchaseRequest  Boolean  @default(true)
  allowSales            Boolean  @default(true)
  createdAt             DateTime @default(now())

  storeStocks      StoreStock[]
  stockMovements   StockMovement[]
  grns             GRN[]
  transfersFrom    InternalTransfer[] @relation("TransferFromStore")
  transfersTo      InternalTransfer[] @relation("TransferToStore")
  disposals        Disposal[]
  purchaseRequests PurchaseRequest[]
  assignedUsers    User[]             @relation("AssignedStore")
  saleBatches      SaleBatch[]
  stockCounts      StockCount[]

  @@index([tenantId])
  @@unique([tenantId, name])
}

model StoreStock {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  qty       Int     @default(0)

  @@index([tenantId])
  @@index([variantId])
  @@unique([storeId, variantId])
}

// -----------------------------
// Suppliers
// -----------------------------

model Supplier {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  taxId         String?
  paymentTerms  String?
  notes         String?
  createdAt     DateTime @default(now())

  grns             GRN[]
  purchaseRequests PurchaseRequest[]

  @@index([tenantId])
}

// -----------------------------
// GRN (Goods Received Note)
// -----------------------------

enum GRNStatus {
  DRAFT
  RECEIVED
}

model GRN {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id])
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  status       GRNStatus @default(RECEIVED)
  referenceNo  String?
  note         String?
  receivedById String
  receivedBy   User      @relation("GRNReceivedBy", fields: [receivedById], references: [id])
  createdAt    DateTime  @default(now())

  items GRNItem[]

  @@index([tenantId])
}

model GRNItem {
  id        String  @id @default(cuid())
  grnId     String
  grn       GRN     @relation(fields: [grnId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  qty       Int
  unitCost  Decimal @db.Decimal(12, 2)
}

// -----------------------------
// Internal Transfer (store to store)
// -----------------------------

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model InternalTransfer {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  fromStoreId   String
  fromStore     Store          @relation("TransferFromStore", fields: [fromStoreId], references: [id])
  toStoreId     String
  toStore       Store          @relation("TransferToStore", fields: [toStoreId], references: [id])
  status        TransferStatus @default(PENDING)
  note          String?
  requestedById String
  requestedBy   User           @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  createdAt     DateTime       @default(now())
  completedAt   DateTime?

  items InternalTransferItem[]

  @@index([tenantId])
}

model InternalTransferItem {
  id         String           @id @default(cuid())
  transferId String
  transfer   InternalTransfer @relation(fields: [transferId], references: [id])
  variantId  String
  variant    Variant          @relation(fields: [variantId], references: [id])
  qty        Int
}

// -----------------------------
// Disposal / Returns
// -----------------------------

enum DisposalType {
  DISPOSAL
  RETURN
}

model Disposal {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id])
  type        DisposalType
  reason      String?
  createdById String
  createdBy   User         @relation("DisposalCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  items DisposalItem[]

  @@index([tenantId])
}

model DisposalItem {
  id         String   @id @default(cuid())
  disposalId String
  disposal   Disposal @relation(fields: [disposalId], references: [id])
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id])
  qty        Int
}

// -----------------------------
// Purchase Requests
// -----------------------------

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

model PurchaseRequest {
  id            String                @id @default(cuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  storeId       String
  store         Store                 @relation(fields: [storeId], references: [id])
  supplierId    String?
  supplier      Supplier?             @relation(fields: [supplierId], references: [id])
  status        PurchaseRequestStatus @default(PENDING)
  note          String?
  requestedById String
  requestedBy   User                  @relation("PurchaseRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?                 @relation("PurchaseApprovedBy", fields: [approvedById], references: [id])
  createdAt     DateTime              @default(now())
  reviewedAt    DateTime?

  items PurchaseRequestItem[]

  @@index([tenantId])
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  variantId         String
  variant           Variant         @relation(fields: [variantId], references: [id])
  qty               Int
  note              String?
}

// -----------------------------
// Generic stock movement log (audit trail)
// storeId is nullable to support any legacy movements without one;
// new movements (GRN/Transfer/Disposal) should always set it.
// -----------------------------

enum MovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  COUNT_CORRECTION
  GRN
  TRANSFER_OUT
  TRANSFER_IN
  DISPOSAL
  RETURN
}

model StockMovement {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  variantId  String
  variant    Variant      @relation(fields: [variantId], references: [id])
  storeId    String?
  store      Store?       @relation(fields: [storeId], references: [id])
  type       MovementType
  qtyChange  Int          // positive for stock in, negative for stock out
  employeeId String?
  employee   User?        @relation(fields: [employeeId], references: [id])
  note       String?
  createdAt  DateTime     @default(now())

  @@index([tenantId])
  @@index([variantId])
  @@index([storeId])
}

// -----------------------------
// Sales — INTENTIONALLY UNCHANGED FOR NOW.
// Not yet linked to Store — waiting on the point-of-sale /
// stock-deduction design decision before adding storeId here.
// -----------------------------

model Sale {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id])
  employeeId  String
  employee    User     @relation(fields: [employeeId], references: [id])
  qty         Int
  priceAtSale Decimal  @db.Decimal(12, 2) // per unit, snapshot at time of sale
  costAtSale  Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  batchId     String?
  batch       SaleBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([employeeId])
  @@index([createdAt])
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_MONEY
  OTHER
}

model BankAccount {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  bankName       String
  accountLast4   String?
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  saleBatches SaleBatch[]
  expenses    Expense[]

  @@index([tenantId])
  @@unique([tenantId, name])
}

model SaleBatch {
  id                  String        @id @default(cuid())
  tenantId            String
  tenant              Tenant        @relation(fields: [tenantId], references: [id])
  storeId             String
  store               Store         @relation(fields: [storeId], references: [id])
  employeeId          String
  employee            User          @relation(fields: [employeeId], references: [id])
  paymentMethod       PaymentMethod
  bankAccountId       String?
  bankAccount         BankAccount?  @relation(fields: [bankAccountId], references: [id])
  transactionReference String?
  createdAt           DateTime      @default(now())
  items               Sale[]

  @@index([tenantId])
  @@index([storeId, createdAt])
}

// -----------------------------
// Expenses
// -----------------------------

enum ExpenseCategory {
  TRANSPORT
  RENT
  SALARY
  OTHER
}

model Expense {
  id       String          @id @default(cuid())
  tenantId String
  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  category ExpenseCategory
  amount   Decimal         @db.Decimal(12, 2)
  date     DateTime
  note     String?
  customCategory String?
  paymentMethod PaymentMethod @default(CASH)
  bankAccountId String?
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([tenantId])
  @@index([date])
}

model StoreFeedback {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String?
  rating    Int
  message   String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// -----------------------------
// Monthly Closing (owner picks a date range)
// -----------------------------

model ClosingPeriod {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  startDate        DateTime
  endDate          DateTime
  totalSales       Decimal  @db.Decimal(12, 2)
  totalExpenses    Decimal  @db.Decimal(12, 2)
  costOfGoods      Decimal  @default(0) @db.Decimal(12, 2)
  totalCommissions Decimal  @db.Decimal(12, 2)
  netResult        Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  @@index([tenantId])
}

// -----------------------------
// Stock counting / reconciliation
// Note: once Store is in play, a real count should probably be
// per-store too (systemQty should come from StoreStock, not a
// single Variant balance) — worth revisiting when we build this
// feature for real, alongside the Sale/POS decision.
// -----------------------------

model StockCount {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id])
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  systemQty   Int
  countedQty  Int
  variance    Int
  countedById String
  countedBy   User     @relation(fields: [countedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([variantId])
}
